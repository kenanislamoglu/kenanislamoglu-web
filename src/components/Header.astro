---
import { NAV, SITE } from '../consts';
import { cleanPath } from '../lib/url';

const path = cleanPath(Astro.url);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href="/">{SITE.title}</a>

    <nav class="site-nav" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={
              item.href === '/'
                ? path === '/'
                  ? 'page'
                  : undefined
                : path.startsWith(item.href)
                  ? 'page'
                  : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" data-theme-toggle aria-live="polite">
        Theme
      </button>
    </nav>
  </div>
</header>
