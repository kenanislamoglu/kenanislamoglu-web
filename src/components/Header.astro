---
import { getCollection } from 'astro:content';
import { NAV, SITE } from '../consts';
import { cleanPath } from '../lib/url';

// Sections without published entries stay out of the nav until the first one ships.
const counts: Record<string, number> = {
  '/engineering-log': (await getCollection('engineering-log', ({ data }) => !data.draft)).length,
  '/field-notes': (await getCollection('field-notes', ({ data }) => !data.draft)).length,
};
const nav = NAV.filter((item) => counts[item.href] !== 0);

const path = cleanPath(Astro.url);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href="/">{SITE.title}</a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={
              item.href === '/'
                ? path === '/'
                  ? 'page'
                  : undefined
                : path.startsWith(item.href)
                  ? 'page'
                  : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" data-theme-toggle aria-live="polite">
        Theme
      </button>
    </nav>
  </div>
</header>
