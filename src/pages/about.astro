---
import Base from '../layouts/Base.astro';

// One reverse-chronological timeline: work, study and current AI work side by side.
const timeline = [
  {
    when: 'Now',
    title: 'AI engineering',
    detail:
      'Building AI systems with verification built in. Lintel, my twelve-agent personal system, accepts a fix only with a test that fails without it. Write-ups go to the Engineering Log.',
  },
  {
    when: '2026',
    title: 'AI agents at Tatil Sepeti',
    detail:
      'Built AI agents with Claude Code at Tatil Sepeti: a RAG-based knowledge assistant that answers from internal documentation and cites its sources, rule-based monitoring, and scheduled automations. Also set up an AI-assisted development process in which every change passes analysis, development and independent testing steps.',
  },
  {
    when: '2026',
    title: 'Journal article: A Layered Vulnerability Detection Model for E-Commerce Platforms: Design and Evaluation',
    detail:
      'With Fatma Nur Akı. İstanbul Commerce University Journal of Technology and Applied Sciences, 8(2), 105–118 (peer-reviewed). Builds on my MSc thesis.',
    link: { href: 'https://doi.org/10.56809/icujtas.1755050', label: 'doi:10.56809/icujtas.1755050' },
  },
  {
    when: '2023–2025',
    title: 'MSc in Computer Engineering (Cybersecurity), thesis-based',
    detail:
      'İstanbul Commerce University, completed while leading the team. Thesis: “Security Vulnerability Detection and Reporting Model in E-Commerce Sites”, advised by Asst. Prof. Fatma Nur Akı. A five-stage process (target definition, information gathering, vulnerability scanning with OWASP ZAP, Burp Suite, Nikto and Nmap, manual verification to remove false positives, and reporting with CVSS v3.1 scores in separate technical and executive reports), validated on a nopCommerce store in an isolated lab.',
  },
  {
    when: '2021–present',
    title: 'Software Engineering Team Lead, Tatil Sepeti',
    detail:
      'Lead a 10-person team and still write code: backend services and integrations with 15–20 travel suppliers (SOAP/XML and REST), plus the code review and quality gates the team ships through.',
  },
  {
    earlier: true,
    when: '2021',
    title: 'Introduction to Machine Learning',
    detail: 'TOBB University of Economics and Technology (certificate).',
  },
  {
    earlier: true,
    when: '2020–2021',
    title: 'Senior Software Engineer, NTT DATA Business Solutions Turkey',
    detail:
      'Technical lead on a large enterprise HR platform; real-time notifications and reporting with SignalR on Azure.',
  },
  {
    earlier: true,
    when: '2017–2020',
    title: 'Software Development Manager, Pronto Tur',
    detail:
      'Ran development and delivery of a flight and hotel booking platform with a 10-person team.',
  },
  {
    earlier: true,
    when: '2013–2017',
    title: 'Senior Software Engineer, Pronto Tur',
    detail:
      'Brought flight and hotel inventory from different suppliers into one search-and-booking flow; built dynamic flight + hotel packaging on top of it.',
  },
  {
    earlier: true,
    when: '2008–2013',
    title: 'Software Developer, İstanbul Metropolitan Municipality, İETT, SAYSİS, Gülaylar Group',
    detail: 'Enterprise web, desktop and service applications on .NET.',
  },
  {
    earlier: true,
    when: '2006',
    title: 'BA in Business Administration',
    detail: 'Afyon Kocatepe University.',
  },
  {
    earlier: true,
    when: '2004–2006',
    title: 'First product, sold on CD',
    detail:
      'While studying business, I taught myself Flash MX and built an animated yearbook on my own, then sold it on CD to four classes at my university. Alongside it I made animations for quiz competitions and multimedia CDs. Projects like these are how I moved from business into software.',
  },
];
---

<Base
  title="About"
  description="C#/.NET engineer and team lead since 2008, now focused on AI engineering and agent security."
  profilePage
>
  <h1>About</h1>
  <p class="lede">
    I've built software in C# and .NET since 2008, most of it in travel booking:
    one search-and-booking flow over many flight, hotel and car-rental suppliers.
    I lead a 10-person team and still write code, review and quality gates
    included. I hold a thesis-based MSc in Cybersecurity. Lately I build AI
    agents, and I make them prove their work.
  </p>

  <ul class="stats" aria-label="At a glance">
    <li><b>2008</b><span>building with C# and .NET</span></li>
    <li><b>10</b><span>person team, lead since 2021</span></li>
    <li><b>15–20</b><span>travel-supplier integrations</span></li>
    <li><b>MSc</b><span>Cybersecurity, plus a peer-reviewed article</span></li>
  </ul>

  <hr />

  <section>
    <p class="eyebrow">Timeline</p>
    <ul class="entry-list">
      {
        timeline.filter((item) => !item.earlier).map((item) => (
          <li>
            <p class="meta">{item.when}</p>
            <h2 class="entry__title">{item.title}</h2>
            <p class="entry__summary">{item.detail}</p>
            {item.link && (
              <p class="entry__summary">
                <a href={item.link.href}>{item.link.label}</a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <details class="more">
      <summary>Earlier, 2004–2021: team lead and senior roles in travel booking, enterprise .NET, the first product</summary>
      <ul class="entry-list">
        {
          timeline.filter((item) => item.earlier).map((item) => (
          <li>
            <p class="meta">{item.when}</p>
            <h2 class="entry__title">{item.title}</h2>
            <p class="entry__summary">{item.detail}</p>
            {item.link && (
              <p class="entry__summary">
                <a href={item.link.href}>{item.link.label}</a>
              </p>
            )}
          </li>
          ))
        }
      </ul>
    </details>
  </section>

</Base>
