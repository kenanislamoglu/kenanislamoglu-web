---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';

const entries = (await getCollection('engineering-log', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((post) => ({
    href: `/engineering-log/${post.id}`,
    title: post.data.title,
    summary: post.data.takeaway ?? post.data.description,
    pubDate: post.data.pubDate,
    tags: post.data.tags,
  }));
---

<Base
  title="Engineering Log"
  description="Post-mortems, architecture breakdowns and benchmark-backed case studies."
>
  <h1>Engineering Log</h1>
  <p class="lede">
    Case studies from production systems: what broke, how it was diagnosed, and
    the trade-offs behind the fix. Written for engineers who will have to make
    the same call.
  </p>
  <EntryList entries={entries} emptyMessage="First entry is in progress." />
</Base>
