---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('field-notes', ({ data }) => !data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const topics = [...new Set(notes.map((note) => note.data.topic))].sort();
---

<Base
  title="Field Notes"
  description="Working reference notes on distributed systems, cryptography and security architecture."
>
  <h1>Field Notes</h1>
  <p class="lede">
    A working reference rather than a blog: condensed notes on protocols,
    failure modes and security architecture. Revised in place as understanding
    improves.
  </p>

  {
    topics.length === 0 ? (
      <p class="lede">First notes are being written up.</p>
    ) : (
      topics.map((topic) => (
        <section>
          <h2>{topic}</h2>
          <ul class="entry-list">
            {notes
              .filter((note) => note.data.topic === topic)
              .map((note) => (
                <li>
                  <h3 class="entry__title">
                    <a href={`/field-notes/${note.id}`}>{note.data.title}</a>
                  </h3>
                  <p class="entry__summary">{note.data.description}</p>
                </li>
              ))}
          </ul>
        </section>
      ))
    )
  }
</Base>
