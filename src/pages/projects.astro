---
import Base from '../layouts/Base.astro';
import { PROJECTS } from '../consts';
---

<Base
  title="Side projects"
  description="Small apps Kenan İslamoğlu builds in his spare time: Lintel, a multi-agent personal AI system; EARSHOT, an audio-only horror game; Ease, an on-duty pharmacy finder; and UNSEEN, a multiplayer game on Roblox."
>
  <h1>Side projects</h1>
  <p class="lede">
    Small apps I build in my spare time, for the fun of it and to try ideas I
    don't get to use at work. My day job is backend engineering and leading a
    team; that story is on the <a href="/about">About page</a>.
  </p>

  <ul class="entry-list">
    {
      PROJECTS.map((project) => (
        <li>
          <p class="meta">
            {project.platform} · {project.status}
          </p>
          <h2 class="entry__title" id={project.short.toLowerCase()}>
            {project.href ? <a href={project.href}>{project.name}</a> : project.name}
          </h2>
          <p class="entry__summary">{project.description}</p>
          <p class="entry__summary">
            <strong>Stack:</strong> {project.stack.join(' · ')}
          </p>
          <p class="entry__summary">{project.note}</p>
          {project.links.length > 0 && (
            <p>
              {project.links.map((link, index) => (
                <>
                  {index > 0 && ' · '}
                  <a href={link.href} rel="noopener">
                    {link.label}
                  </a>
                </>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
