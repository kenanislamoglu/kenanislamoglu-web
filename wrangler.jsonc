{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kenanislamoglu-web",
  "compatibility_date": "2026-08-30",

  // Static build output; the Worker only redirects www to the apex.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Astro is configured with trailingSlash: 'never', so serve /foo (not /foo/).
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Custom domains are created (with their DNS records) on deploy.
  // www stays as a custom domain so its DNS record exists; the Worker 301s it.
  "routes": [
    { "pattern": "kenanislamoglu.com", "custom_domain": true },
    { "pattern": "www.kenanislamoglu.com", "custom_domain": true }
  ]
}
